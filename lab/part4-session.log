[?2004lapiVersion: v2
name: debug-lab
description: >-
  Enterprise Bot debug lab — a small platform slice (gateway, backend, worker,
  reporter, metrics, and a migration Job) that is currently broken in six ways.
type: application
version: 2.0.0
appVersion: "1.0.1"
apiVersion: v1
kind: ServiceAccount
metadata:
  name: reporter
  labels:
    app: reporter
    {{- include "lab.labels" . | nindent 4 }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: reporter-read
  labels:
    app: reporter
    {{- include "lab.labels" . | nindent 4 }}
rules:
  - apiGroups: [""]
    resources: ["pods"]
    verbs: ["get", "list"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: reporter-read
  labels:
    app: reporter
    {{- include "lab.labels" . | nindent 4 }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: reporter-read
subjects:
  - kind: ServiceAccount
    name: reporter
    namespace: {{ .Release.Namespace }}
